# Copy to .env to change a setting. Everything works with the defaults.

# Stage 2 grammar model: free cloud LLMs (Groq, then Gemini), used first when a key is set (only text is sent, never audio)
#   Gemini: https://aistudio.google.com/apikey      Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-...     # default: the newest free Flash-Lite, chosen automatically
# GROQ_MODEL=openai/gpt-oss-120b
# STAGE2_ORDER=groq,gemini    # which one is asked first (Groq: same accuracy, 4x faster in testing)

# Local fallback LLM (Ollama, https://ollama.com), used for English when the cloud models are unreachable
OLLAMA_URL=http://localhost:11434
STAGE2_MODEL=llama3.2
STAGE2_TIMEOUT=60

# Languages where the LOCAL model is not used (it made them worse; measured reasons in README)
STAGE2_SKIP_LANGUAGES=bn-IN,pa-IN,hi-IN,mr-IN

# Speech recognition (defaults measured best, see README)
# INDIAN_ASR=google                     # one engine for all Indian languages (default: IndicConformer RNNT for hi/mr, CTC for pa, Google for bn)
# ENGLISH_ASR=mlx:large-v3-turbo:fast   # or: mlx:large-v3, parakeet:v3, whisper (CPU), google
# Stage 1 spelling repair for Bengali and Hindi (1 = on)
SPELLING_REPAIR=1

# Optional extra English grammar pass with LanguageTool's free public API (rate-limited)
ENABLE_LANGUAGETOOL=0

HOST=127.0.0.1
PORT=8010
